# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgres://enos:password@localhost:5432/enos
JWT_SECRET=replace-with-a-long-random-value
PORT=4000

# Elayja / Gemini integration — left blank until Step 14 (connect only
# after identity, entitlement and audit controls are proven in staging)
GEMINI_API_KEY=

# Base URL used to construct opaque QR short links: go.varizen.co/q/{token}
QR_SHORT_LINK_BASE=https://go.varizen.co/q
