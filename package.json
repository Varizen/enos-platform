{
  "name": "enos-platform",
  "version": "0.1.0",
  "description": "Varizen ENOS — cloud control plane (governance, security, resource, execution, intelligence, portfolio). NOT a Linux distribution.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "migrate": "psql \"$DATABASE_URL\" -f db/001_core_schema.sql && psql \"$DATABASE_URL\" -f db/002_seed_data.sql",
    "test": "jest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.18",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "jest": "^29.7.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
